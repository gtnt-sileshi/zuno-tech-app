<?xml version="1.0" encoding="utf-8"?>
<!-- Home section: one header style (accent bar, 16sp title, optional "See All") above a card list.
     Spacing between sections and between header and cards comes from HomeSpacingDecoration. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_section_header_bar"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_home_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="?ns_title"
            android:textSize="@dimen/text_section" />

        <!-- Hidden by the adapter when there is nothing to open -->
        <LinearLayout
            android:id="@+id/ll_home_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_see_all_btn"
            android:gravity="center"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:textColor="?ns_primary"
                android:textSize="@dimen/text_caption"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cards: 16dp edge margin, scrolls under the padding -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home_cat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_8sdp" />
</LinearLayout>
