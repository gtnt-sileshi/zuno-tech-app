<?xml version="1.0" encoding="utf-8"?>
<!--
  Zumi Pro — Splash screen (lightweight)
  Single RelativeLayout, no nested layouts, no decoration views.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_full"
    android:fitsSystemWindows="true">

    <!-- ── Center block: logo + name + tagline ── -->
    <LinearLayout
        android:id="@+id/ll_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="@dimen/_90sdp"
            android:src="@drawable/logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/_24ssp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/splash_tagline"
            android:textColor="#80FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- ── Bottom: progress bar + version ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_36sdp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_48sdp"
        android:paddingEnd="@dimen/_48sdp">

        <TextView
            android:id="@+id/tv_loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text="@string/splash_loading"
            android:textColor="#55FFFFFF"
            android:textSize="@dimen/_10ssp"
            android:letterSpacing="0.08"
            android:visibility="invisible" />

        <ProgressBar
            android:id="@+id/pb_splash"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_4sdp"
            android:progressDrawable="@drawable/bg_splash_progress_fill"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="v1.0.0"
            android:textColor="#40FFFFFF"
            android:textSize="@dimen/_10ssp"
            android:letterSpacing="0.05" />

    </LinearLayout>

</RelativeLayout>
