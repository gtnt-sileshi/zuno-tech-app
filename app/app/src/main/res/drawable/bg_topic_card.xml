<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle rounded card background for topic items.
     Uses ns_bg_sub (light blue on light theme, dark surface on dark themes)
     with a thin brand-tinted border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/ns_bg_sub" />
    <corners android:radius="@dimen/_12sdp" />
    <stroke android:width="@dimen/_1sdp" android:color="?attr/ns_border" />
</shape>
