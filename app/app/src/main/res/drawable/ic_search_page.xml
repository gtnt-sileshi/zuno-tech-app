<?xml version="1.0" encoding="utf-8"?>
<!--
  Zuno Tech — search icon.
  android:tint="?colorControlNormal" makes Android apply the correct
  icon tint for the current theme automatically — dark on light toolbar,
  white on dark toolbar. The internal color is irrelevant once tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?colorControlNormal">
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M21,21 L16.65,16.65 M19,11 a8,8 0 1,0 -16,0 a8,8 0 1,0 16,0 Z" />
</vector>
